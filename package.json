{
  "name": "dz-commerce-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "fix": "eslint . --fix; prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @dz/admin --filter @dz/store --workspace-concurrency=1 test:e2e",
    "db:local": "bash scripts/dev-db.sh",
    "db:generate": "pnpm --filter @dz/db generate",
    "db:migrate": "pnpm --filter @dz/db migrate:dev",
    "db:deploy": "pnpm --filter @dz/db migrate:deploy",
    "db:seed": "pnpm --filter @dz/api seed",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
