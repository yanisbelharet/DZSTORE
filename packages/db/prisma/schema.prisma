// DZ Commerce OS — schéma de base de données.
// Conventions (ADR-0005) : UUIDv7, montants Int en DZD, timestamptz UTC, JSON validé par Zod.
// Les modèles arrivent avec leur phase (voir docs/ARCHITECTURE.md, annexe A).
// Contraintes non exprimables en Prisma : ajoutées en SQL dans les migrations (ARCHITECTURE §3).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  OWNER
  ADMIN
  CONFIRMATION_AGENT
  FOLLOWUP_AGENT
}

enum Locale {
  ar
  fr
  en
}

enum SessionKind {
  WEB
  MOBILE
}

enum ActorType {
  USER
  SYSTEM
  CARRIER
  CUSTOMER
}

enum SecretKind {
  CARRIER_TOKEN
  PIXEL_ACCESS_TOKEN
  AI_API_KEY
  TOTP_SECRET
  OTHER
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
  CANCELLED
}

// ──────────────────────────── Plateforme ────────────────────────────

model Store {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique
  name          String
  orderPrefix   String   @unique // ex. "DZ" → DZ-000123
  defaultLocale Locale   @default(ar)
  locales       Locale[] @default([ar, fr])
  timezone      String   @default("Africa/Algiers")
  theme         Json     @default("{}") // ThemeSchema (Zod)
  settings      Json     @default("{}") // StoreSettingsSchema (Zod)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  domains    StoreDomain[]
  counters   StoreCounter[]
  userAccess UserStoreAccess[]
  media      Media[]
  products   Product[]
  variants   ProductVariant[]
}

model StoreDomain {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   String   @db.Uuid
  hostname  String   @unique // minuscules, sans port
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model StoreCounter {
  storeId String @db.Uuid
  name    String // "order"
  value   Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, name])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ───────────────────────── Identité & sécurité ─────────────────────────

model User {
  id                   String    @id @default(uuid(7)) @db.Uuid
  email                String    @unique // stocké en minuscules
  name                 String
  passwordHash         String // Argon2id
  roles                Role[]
  locale               Locale    @default(fr)
  isActive             Boolean   @default(true)
  totpSecretId         String?   @unique @db.Uuid
  totpEnabledAt        DateTime? @db.Timestamptz(3)
  totpLastUsedStep     Int? // anti-rejeu : dernier pas de temps TOTP accepté
  recoveryCodes        String[] // hachés (SHA-256), à usage unique
  failedLoginCount     Int       @default(0)
  lastFailedLoginAt    DateTime? @db.Timestamptz(3) // les échecs anciens (> 24 h) ne comptent plus
  failedTwoFactorCount Int       @default(0) // échecs 2FA consécutifs ; plafond ⇒ verrouillage
  lockedUntil          DateTime? @db.Timestamptz(3)
  lastLoginAt          DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  totpSecret  Secret?           @relation("UserTotpSecret", fields: [totpSecretId], references: [id])
  storeAccess UserStoreAccess[]
  sessions    Session[]
  auditLogs   AuditLog[]
}

model UserStoreAccess {
  userId  String @db.Uuid
  storeId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model Session {
  id                String      @id @default(uuid(7)) @db.Uuid
  userId            String      @db.Uuid
  tokenHash         String      @unique // SHA-256 du jeton opaque
  kind              SessionKind
  twoFactorVerified Boolean     @default(false)
  remembered        Boolean     @default(false) // « se souvenir de cet appareil » : inactivité 7 j
  ipPrefix          String? // IP tronquée, pour l'écran « sessions actives »
  userAgent         String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime    @db.Timestamptz(3) // glissante
  absoluteExpiresAt DateTime    @db.Timestamptz(3)
  revokedAt         DateTime?   @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  at          DateTime  @default(now()) @db.Timestamptz(3)
  actorType   ActorType
  actorUserId String?   @db.Uuid
  action      String // ex. "order.forceStatus", "secret.rotate"
  entityType  String
  entityId    String?
  storeId     String?   @db.Uuid
  ipPrefix    String?
  before      Json?
  after       Json?
  meta        Json?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, at])
  @@index([action, at])
}

model Secret {
  id         String     @id @default(uuid(7)) @db.Uuid
  kind       SecretKind
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  keyVersion Int
  last4      String? // affichage masqué uniquement
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  rotatedAt  DateTime?  @db.Timestamptz(3)

  userTotp User? @relation("UserTotpSecret")
}

model IdempotencyKey {
  scope       String // ex. "order.create:<storeId>"
  key         String
  requestHash String
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
}

/// Compteurs de limitation de débit par fenêtre fixe. Table UNLOGGED (migration SQL) :
/// données éphémères, perdues sans conséquence en cas de crash.
model RateLimitBucket {
  key         String // empreinte SHA-256 de « <règle>:<identifiant> »
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)
  expiresAt   DateTime @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement())
  type          String // ex. "order.statusChanged"
  aggregateType String
  aggregateId   String
  payload       Json // identifiants uniquement, jamais de données personnelles
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  dispatchedAt  DateTime?    @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

/// File de jobs (ADR-0023). Consommée avec FOR UPDATE SKIP LOCKED.
model Job {
  id             BigInt    @id @default(autoincrement())
  queue          String // nom du handler, ex. "maintenance.purge-sessions"
  payload        Json // identifiants uniquement, jamais de données personnelles
  status         JobStatus @default(PENDING)
  priority       Int       @default(0) // plus grand = plus prioritaire
  runAt          DateTime  @default(now()) @db.Timestamptz(3)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  /// Un seul job RUNNING par clé (ex. compte transporteur) — index unique partiel SQL.
  concurrencyKey String?
  /// Mise en file idempotente : unique par file.
  dedupeKey      String?
  lockedBy       String?
  lockedUntil    DateTime? @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)

  @@unique([queue, dedupeKey])
  @@index([status, runAt, priority])
  @@index([status, lockedUntil])
  @@index([concurrencyKey, status])
}

/// Tâches planifiées à intervalle fixe (maintenance, synchronisations).
model ScheduledTask {
  name            String    @id // = nom du job à mettre en file
  intervalSeconds Int
  nextRunAt       DateTime  @db.Timestamptz(3)
  lastRunAt       DateTime? @db.Timestamptz(3)
  enabled         Boolean   @default(true)
}

// ─── Référentiel géographique (P1-01, @dz/geo) ───

/// Wilaya (code officiel, loi 84-09 modifiée : 69 wilayas depuis la loi 26-06).
model Wilaya {
  id        Int     @id // code officiel
  nameAr    String
  nameFr    String
  nameAscii String
  isActive  Boolean @default(true)

  communes Commune[]
}

/// Commune (1541) : identifiant stable = numéro de l'élément Wikidata (un redécoupage change
/// la wilaya, jamais l'identifiant).
model Commune {
  id             Int     @id
  wilayaId       Int
  nameAr         String
  nameFr         String
  nameAscii      String
  postalCode     String?
  isActive       Boolean @default(true)
  /// Wilaya du modèle à 58 (2019–2026), encore utilisé par les transporteurs et les clients.
  legacyWilayaId Int
  /// Raison de vérifier cette entrée auprès d'une autre source (null = vérifiée).
  toVerify       String?

  wilaya  Wilaya     @relation(fields: [wilayaId], references: [id])
  aliases GeoAlias[]

  @@unique([wilayaId, nameAscii])
  @@index([wilayaId])
  @@index([legacyWilayaId])
}

enum GeoAliasKind {
  FORMER_NAME // renommée par une loi
  VARIANT // autre orthographe en usage
}

/// Ancien nom ou variante d'une commune (AR/FR) : les clients et transporteurs les utilisent.
model GeoAlias {
  id        Int          @id @default(autoincrement())
  communeId Int
  lang      String // 'ar' | 'fr'
  name      String
  nameKey   String // nom normalisé (@dz/geo matchKey) pour la recherche
  kind      GeoAliasKind

  commune Commune @relation(fields: [communeId], references: [id], onDelete: Cascade)

  @@unique([communeId, lang, nameKey])
  @@index([nameKey])
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

/// Uploaded image (ADR-0017): sanitised original + AVIF/WebP variants generated by `media.process`.
model Media {
  id            String      @id @default(uuid(7)) @db.Uuid
  storeId       String      @db.Uuid
  storageKey    String      @unique // original (rotated, metadata stripped)
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  alt           Json? // { ar?, fr? } (Zod: mediaAltSchema)
  variants      Json        @default("[]") // [{ format, width, height, bytes, key }] (Zod)
  status        MediaStatus @default(PROCESSING)
  failureReason String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  products ProductMedia[]

  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Catalogue (PRD §5). Localised texts and options are JSON validated by Zod (@dz/contracts).
model Product {
  id        String        @id @default(uuid(7)) @db.Uuid
  storeId   String        @db.Uuid
  slug      String
  name      String // nom interne (admin)
  status    ProductStatus @default(DRAFT)
  content   Json // { title: {ar,fr}, description: {ar,fr} }
  options   Json          @default("[]") // [{ key, name: {ar,fr}, values: [{ key, label: {ar,fr} }] }]
  seo       Json          @default("{}") // { title: {ar,fr}, description: {ar,fr}, ogImageMediaId }
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  media    ProductMedia[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, updatedAt(sort: Desc), id(sort: Desc)])
}

model ProductVariant {
  id                String   @id @default(uuid(7)) @db.Uuid
  productId         String   @db.Uuid
  storeId           String   @db.Uuid // dénormalisé pour l'unicité du SKU
  sku               String
  options           Json     @default("{}") // { color: "black", size: "l" } (clés des options)
  price             Int
  compareAtPrice    Int?
  costPrice         Int
  weightGrams       Int?
  carrierProductRef String? // référence produit chez le transporteur (stock délocalisé)
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  media   ProductMedia[]

  @@unique([storeId, sku])
  @@index([productId])
}

model ProductMedia {
  productId String  @db.Uuid
  mediaId   String  @db.Uuid
  variantId String? @db.Uuid
  position  Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@id([productId, mediaId])
  @@index([mediaId])
}
