{
  "name": "@dz/store",
  "version": "0.0.0",
  "private": true,
  "description": "Boutique publique : Astro SSR + îlots Preact, résolution de la boutique par nom d’hôte.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check --minimumSeverity warning && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "astro build && playwright test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/preact": "6.1.1",
    "@astrojs/vercel": "11.0.17",
    "@dz/contracts": "workspace:*",
    "@dz/core": "workspace:*",
    "@fontsource-variable/cairo": "5.3.0",
    "astro": "7.4.4",
    "pino": "^10.4.0",
    "preact": "11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@dz/config": "workspace:*",
    "@dz/db": "workspace:*",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0"
  }
}
