{
  "name": "@dz/api",
  "version": "0.0.0",
  "private": true,
  "description": "API HTTP (Fastify) et worker de jobs.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "node src/main-http.ts",
    "worker:dev": "node --env-file-if-exists=../../.env --watch src/main-worker.ts",
    "worker": "node src/main-worker.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "create-owner": "node --env-file-if-exists=../../.env src/cli/create-owner.ts",
    "seed": "node --env-file-if-exists=../../.env src/cli/seed.ts",
    "vercel-build": "node scripts/vercel-build.ts",
    "dev:http": "node --env-file-if-exists=../../.env --watch src/main-http.ts",
    "sync-geo": "node --env-file-if-exists=../../.env src/cli/sync-geo.ts"
  },
  "dependencies": {
    "@dz/contracts": "workspace:*",
    "@dz/core": "workspace:*",
    "@dz/db": "workspace:*",
    "@dz/domain": "workspace:*",
    "@dz/geo": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dz/config": "workspace:*",
    "openapi-types": "^12.1.3",
    "vite": "8.3.5"
  }
}
