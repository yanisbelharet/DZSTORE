# DZ Commerce OS — variables d'environnement.
# Copier en `.env` (jamais commité) et renseigner. Chaque tâche qui introduit une variable
# l'ajoute ici avec un commentaire, sans valeur réelle.

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Clés de chiffrement des secrets (tokens transporteur, pixels, clés IA), ADR-0009.
# Format : <version>:<clé base64 de 32 octets>, séparées par des virgules ; la version la plus
# haute chiffre, toutes déchiffrent (rotation). Générer une clé :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Ne jamais réutiliser une clé de développement en production.
APP_ENCRYPTION_KEYS=

# PostgreSQL local, créé par `pnpm db:local` (identifiants de développement uniquement).
DATABASE_URL=postgresql://dz:dz@localhost:5432/dz_dev
# Base réservée aux tests d'intégration : elle est vidée par les tests, ne jamais y mettre de
# données utiles.
DATABASE_URL_TEST=postgresql://dz:dz@localhost:5432/dz_test

# ─── API (apps/api) ───
HOST=0.0.0.0
PORT=3000
# Origines autorisées par CORS, séparées par des virgules. Vide par défaut : l'admin appelle
# l'API sur sa propre origine (/api), ADR-0021.
CORS_ORIGINS=
# Taille maximale d'un corps de requête (octets).
BODY_LIMIT_BYTES=262144
# true derrière un proxy de confiance (Caddy, Cloudflare, Vercel) pour lire X-Forwarded-*.
TRUST_PROXY=false
# Cookie de session sécurisé (__Host-dz_session). Laisser true ; les navigateurs l'acceptent sur
# http://localhost. false uniquement pour un accès en http depuis une autre machine.
SESSION_COOKIE_SECURE=true
# Active POST /v1/internal/tick (traitement des jobs à la demande, environnement serverless).
# Vide = désactivé. Au moins 32 caractères aléatoires.
TICK_SECRET=
# Jeton partagé avec le serveur du store pour les routes /v1/public/* (en-tête
# x-dz-service-token). Vide = ces routes refusent tout. Au moins 32 caractères aléatoires :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STORE_SERVICE_TOKEN=

# ─── Store (apps/store) ───
# URL de l'API vue depuis le serveur du store (réseau interne en production).
STORE_API_URL=http://localhost:3000
# STORE_SERVICE_TOKEN ci-dessus : même valeur côté API et côté store.
# Délai maximal d'un appel à l'API (ms) et durée de mémorisation hôte → boutique (s).
STORE_API_TIMEOUT_MS=2000
STORE_RESOLVE_TTL_SECONDS=60
# Origines autorisées à afficher le store dans un cadre (aperçu du builder dans l'admin),
# séparées par des virgules. Vide = aucune (frame-ancestors 'none').
STORE_FRAME_ANCESTORS=
# Adaptateur Astro choisi au build : node (VPS, local, e2e) ou vercel (environnement de test).
STORE_ADAPTER=node
# Désactive la télémétrie anonyme d'Astro.
ASTRO_TELEMETRY_DISABLED=1
