# DZ Commerce OS — variables d'environnement.
# Copier en `.env` (jamais commité) et renseigner. Chaque tâche qui introduit une variable
# l'ajoute ici avec un commentaire, sans valeur réelle.

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Clés de chiffrement des secrets (tokens transporteur, pixels, clés IA), ADR-0009.
# Format : <version>:<clé base64 de 32 octets>, séparées par des virgules ; la version la plus
# haute chiffre, toutes déchiffrent (rotation). Générer une clé :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Ne jamais réutiliser une clé de développement en production.
APP_ENCRYPTION_KEYS=

# PostgreSQL local, créé par `pnpm db:local` (identifiants de développement uniquement).
DATABASE_URL=postgresql://dz:dz@localhost:5432/dz_dev
# Base réservée aux tests d'intégration : elle est vidée par les tests, ne jamais y mettre de
# données utiles.
DATABASE_URL_TEST=postgresql://dz:dz@localhost:5432/dz_test
